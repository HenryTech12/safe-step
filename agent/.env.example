# Copy to .env and fill in. NEVER commit .env.
# Used by both the agent worker and the token server (run on your machine/server, never in the app).

# --- LiveKit (cloud.livekit.io → Settings → Keys) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Gemini (Google AI Studio key) ---
GOOGLE_API_KEY=
# Optional override; default is set in safestep_agent/config.py
# GEMINI_MODEL=gemini-3.8-flash

# --- Spitch (STT, and fallback TTS) ---
SPITCH_API_KEY=

# --- YarnGPT (primary TTS) ---
YARNGPT_API_KEY=
# YARNGPT_BASE_URL=https://api.yarngpt.ai
# Voice ids come from GET /api/v1/voices and change over time; leave blank to use YarnGPT's default.
# YARNGPT_VOICE_EN=
# YARNGPT_VOICE_PCM=
# YARNGPT_VOICE_YO=
# YARNGPT_VOICE_HA=
# YARNGPT_VOICE_IG=
# Seconds to wait for the first audio byte before falling back to Spitch TTS.
# YARNGPT_FIRST_BYTE_TIMEOUT=2.0

# --- Token server ---
# TOKEN_SERVER_PORT=8765
# TOKEN_TTL_MINUTES=60
# TOKEN_RATE_LIMIT_PER_MINUTE=6

# --- Latency log (JSON lines) ---
# LATENCY_LOG_PATH=logs/latency.jsonl

# --- Google Maps (Routes API, Places API (New), Geocoding API enabled on the key) ---
GOOGLE_MAPS_API_KEY=
